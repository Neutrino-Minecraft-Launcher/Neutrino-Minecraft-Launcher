import { Palette } from "std-widgets.slint";
import { Page } from "../models/enums.slint";
import { TopBar } from "top-bar.slint";
import { LaunchView } from "../views/launch-view.slint";
import { InstancesView } from "../views/instances-view.slint";
import { AccountView } from "../views/account-view.slint";
import { SettingsView } from "../views/settings-view.slint";

component PagePlaceholder inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 32px;

        Text {
            text: root.title;
            color: Palette.foreground;
            font-size: 30px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: root.subtitle;
            color: Palette.foreground.with-alpha(0.65);
            font-size: 15px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 64px;
                height: 3px;
                border-radius: 6px;
                background: Palette.accent-background;
            }
        }
    }
}

export component AppShell inherits Rectangle {
    in-out property <Page> current-page: Page.launch;
    in property <image> wallpaper: @image-url("../images/backgrounds/Jokull.jpg");

    callback navigate(Page);

    background: #0f1115;

    Image {
        source: root.wallpaper;
        width: 100%;
        height: 100%;
        image-fit: cover;
        accessible-role: none;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.5) 100%);
    }

    VerticalLayout {
        TopBar {
            current-page: root.current-page;

            navigate(page) => {
                root.current-page = page;
                root.navigate(page);
            }
        }

        Rectangle {
            vertical-stretch: 1;

            LaunchView {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.current-page == Page.launch;
            }

            HorizontalLayout {
                visible: root.current-page != Page.launch;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px;

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    border-radius: 6px;
                    background: Palette.background.with-alpha(0.78);
                    border-width: 1px;
                    border-color: Palette.foreground.with-alpha(0.08);
                    clip: true;

                    InstancesView {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        visible: root.current-page == Page.instances;
                    }

                    AccountView {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        visible: root.current-page == Page.account;
                    }

                    PagePlaceholder {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        visible: root.current-page == Page.discover;
                        title: "发现";
                        subtitle: "浏览模组、资源包和整合包";
                    }

                    SettingsView {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        visible: root.current-page == Page.settings;
                    }
                }
            }
        }
    }
}
