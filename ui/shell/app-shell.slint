import { Palette } from "std-widgets.slint";
import { Page } from "../models/enums.slint";
import { TopBar } from "top-bar.slint";
import { LaunchView } from "../views/launch-view.slint";

component PagePlaceholder inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 32px;

        Text {
            text: root.title;
            color: Palette.foreground;
            font-size: 30px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: root.subtitle;
            color: Palette.foreground.with-alpha(0.65);
            font-size: 15px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 64px;
                height: 3px;
                border-radius: 8px;
                background: Palette.accent-background;
            }
        }
    }
}

export component AppShell inherits Rectangle {
    in-out property <Page> current-page: Page.launch;
    in property <image> wallpaper: @image-url("../images/backgrounds/Jokull.jpg");

    callback navigate(Page);

    background: #0f1115;

    Image {
        source: root.wallpaper;
        width: 100%;
        height: 100%;
        image-fit: cover;
        accessible-role: none;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.5) 100%);
    }

    VerticalLayout {
        TopBar {
            current-page: root.current-page;

            navigate(page) => {
                root.current-page = page;
                root.navigate(page);
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if root.current-page == Page.launch : LaunchView { }

            if root.current-page != Page.launch : HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px;

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: Palette.background.with-alpha(0.78);
                    border-width: 1px;
                    border-color: Palette.border;
                    clip: true;

                    if root.current-page == Page.instances : PagePlaceholder {
                        title: "实例";
                        subtitle: "管理你的 Minecraft 实例";
                    }

                    if root.current-page == Page.account : PagePlaceholder {
                        title: "账户";
                        subtitle: "登录并管理你的账户";
                    }

                    if root.current-page == Page.discover : PagePlaceholder {
                        title: "发现";
                        subtitle: "浏览模组、资源包和整合包";
                    }

                    if root.current-page == Page.settings : PagePlaceholder {
                        title: "设置";
                        subtitle: "调整启动器行为";
                    }
                }
            }
        }
    }
}
