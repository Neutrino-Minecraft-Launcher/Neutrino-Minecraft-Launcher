        padding-right: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Text {
          text: "稳定版";
          color: #1e40af;
          font-size: 11px;
          font-weight: 600;
          vertical-alignment: center;
        }
      }
    }

    Text {
      text: "选择";
      color: Palette.accent-background;
      font-size: 12px;
      font-weight: 600;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.choose();
    }
  }
}

// 安装进度条
component InstallStrip inherits Rectangle {    height: 64px;
  border-radius: 6px;
  background: Palette.accent-background.with-alpha(0.10);
  border-width: 1px;
  border-color: Palette.accent-background.with-alpha(0.35);

  HorizontalLayout {
    padding-left: 14px;
    padding-right: 14px;
    spacing: 12px;
    cross-axis-alignment: center;

    VerticalLayout {
      horizontal-stretch: 1;
      alignment: center;
      spacing: 7px;

      Text {
        text: "正在安装 " + AppState.installing-version + "  ·  " + (AppState.install-stage == ""
          ? "准备中"
          : AppState.install-stage);
        color: Palette.foreground;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
      }

      Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Palette.foreground.with-alpha(0.12);

        Rectangle {
          x: 0;
          y: 0;
          width: parent.width * AppState.install-progress;
          height: 100%;
          border-radius: 3px;
          background: Palette.accent-background;
        }
      }
    }

    Text {
      text: AppState.install-progress-text;
      color: Palette.accent-background;
      font-size: 12px;
      font-weight: 600;
      vertical-alignment: center;
      horizontal-alignment: right;
      min-width: 40px;
    }
  }
}

// 提示条
component MessageStrip inherits Rectangle {
  in property <string> message;
  in property <bool> ok;

  height: 40px;
  border-radius: 6px;
  background: root.ok ? Palette.accent-background.with-alpha(0.10) : #fee2e2;
  border-width: 1px;
  border-color: root.ok ? Palette.accent-background.with-alpha(0.30) : #fecaca;

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    cross-axis-alignment: center;

    Text {
      text: root.message;
      color: root.ok ? Palette.foreground : #991b1b;
      font-size: 12px;
      vertical-alignment: center;
      overflow: elide;
    }
  }
}

component ContentRow inherits Rectangle {
  in property <string> name;
  in property <int> size;
  in property <bool> enabled: true;
  /// 模组自带图标；没有时用 `fallback-icon`
  in property <image> icon;
  in property <bool> has-icon;
  in property <image> fallback-icon;
  /// 模组版本（资源包 / 光影为空）
  in property <string> version;
  /// 模组加载器：Fabric / Quilt / Forge / NeoForge
  in property <string> loader;

  pure function format-size(bytes: int) -> string {
    if (bytes >= 1073741824) {
      return floor(bytes / 1073741824.0) + " GB";
    }
    if (bytes >= 1048576) {
      return floor(bytes / 1048576.0) + " MB";
    }
    if (bytes >= 1024) {
      return floor(bytes / 1024.0) + " KB";
    }
    return bytes + " B";
  }

  height: 56px;
  background: row-touch.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 12px;
    cross-axis-alignment: center;

    if root.has-icon : Image {
      source: root.icon;
      width: 32px;
      height: 32px;
      image-fit: contain;
    }

    if !root.has-icon : Image {
      source: root.fallback-icon;
      width: 20px;
      height: 20px;
      colorize: Palette.foreground.with-alpha(0.6);
    }

    HorizontalLayout {
      horizontal-stretch: 1;
      spacing: 6px;
      cross-axis-alignment: center;

      Text {
        text: root.name;
        color: Palette.foreground;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
        max-width: 320px;
      }

      if root.version != "" : Text {
        text: root.version;
        color: Palette.foreground.with-alpha(0.5);
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
      }

      if root.loader != "" : Rectangle {
        height: 20px;
        border-radius: 6px;
        background: #dbeafe;

        HorizontalLayout {
          padding-left: 6px;
          padding-right: 6px;
          alignment: center;
          cross-axis-alignment: center;

          Text {
            text: root.loader;
            color: #1e40af;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
          }
        }
      }

      Rectangle {
        horizontal-stretch: 1;
      }
    }

    Text {
      text: root.format-size(root.size);
      color: Palette.foreground.with-alpha(0.45);
      font-size: 12px;
      vertical-alignment: center;
    }

    Rectangle {
      height: 22px;
      border-radius: 4px;
      background: root.enabled
        ? Palette.accent-background.with-alpha(0.14)
        : Palette.foreground.with-alpha(0.06);

      HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        alignment: center;
        cross-axis-alignment: center;

        Text {
          text: root.enabled ? "已启用" : "已禁用";
          color: root.enabled
            ? Palette.accent-background
            : Palette.foreground.with-alpha(0.5);
          font-size: 12px;
          vertical-alignment: center;
        }
      }
    }
  }

  row-touch := TouchArea { }
}

component ContentPanel inherits Rectangle {
  in property <string> title;
  in property <string> empty-text;
  in property <string> empty-hint;
  in property <string> instance-path;
  in property <string> folder-name;
  in property <image> icon;
  in property <[ContentFile]> items;

  background: transparent;

  VerticalLayout {
    padding-top: 2px;
    spacing: 8px;

    HorizontalLayout {
      spacing: 8px;
      cross-axis-alignment: center;

      Text {
        text: root.title;
        color: Palette.foreground;
        font-size: 14px;
        font-weight: 600;
        horizontal-stretch: 1;
        vertical-alignment: center;
      }

      Text {
        text: "\{root.items.length} 项";
        color: Palette.foreground.with-alpha(0.5);
        font-size: 12px;
        vertical-alignment: center;
      }

      Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: folder-touch.has-hover
          ? Palette.foreground.with-alpha(0.06)
          : transparent;

        Image {
          source: @image-url("../images/icons/folder2-open.svg");
          width: 16px;
          height: 16px;
          colorize: Palette.foreground.with-alpha(0.72);
        }

        folder-touch := TouchArea {
          mouse-cursor: pointer;
          clicked => {
            Actions.open-folder(root.instance-path + "/" + root.folder-name);
          }
        }
      }
    }

    Rectangle {
      vertical-stretch: 1;
      border-radius: 6px;
      background: Palette.background.with-alpha(0.5);
      border-width: 1px;
      border-color: Palette.foreground.with-alpha(0.08);
      clip: true;

      if root.items.length == 0 : VerticalLayout {
        alignment: center;
        spacing: 6px;

        Image {
          source: root.icon;
          width: 28px;
          height: 28px;
          colorize: Palette.foreground.with-alpha(0.3);
        }

        Text {
          text: root.empty-text;
          color: Palette.foreground.with-alpha(0.55);
          font-size: 13px;
          horizontal-alignment: center;
        }

        Text {
          text: root.empty-hint;
          color: Palette.foreground.with-alpha(0.38);
          font-size: 12px;
          horizontal-alignment: center;
        }
      }

      if root.items.length > 0 : ListView {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;

        for item in root.items : ContentRow {
          name: item.name;
          size: item.size;
          enabled: item.enabled;
          icon: item.icon;
          has-icon: item.has-icon;
          fallback-icon: root.icon;
          version: item.version;
          loader: item.loader;
        }
      }
    }
  }
}

component StatCard inherits Rectangle {
  in property <string> label;
  in property <int> count;
  in property <image> icon;

  height: 72px;
  horizontal-stretch: 1;
  border-radius: 6px;
