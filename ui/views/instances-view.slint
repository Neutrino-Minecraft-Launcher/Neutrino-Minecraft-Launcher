import { LineEdit, ListView, Palette } from "std-widgets.slint";
import { InstanceTab, VersionFilter } from "../models/enums.slint";
import { ContentFile } from "../models/instance.slint";
import { AppState } from "../state/app-state.slint";
import { Actions } from "../state/actions.slint";

component InstanceMenuItem inherits Rectangle {
  in property <string> label;
  in property <image> icon;
  in property <bool> selected;

  callback clicked();

  height: 40px;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.14)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.05)
      : transparent;

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 8px;
    cross-axis-alignment: center;

    Image {
      source: root.icon;
      width: 16px;
      height: 16px;
      colorize: Palette.foreground.with-alpha(0.72);
    }

    Text {
      text: root.label;
      color: Palette.foreground;
      font-size: 13px;
      font-weight: root.selected ? 600 : 400;
      vertical-alignment: center;
      overflow: elide;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component InstanceTabItem inherits Rectangle {
  in property <string> label;
  in property <image> icon;
  in property <bool> selected;

  callback clicked();

  height: 32px;
  horizontal-stretch: 0;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.14)
    : touch.has-hover
      ? Palette.foreground.with-alpha(0.05)
      : transparent;

  HorizontalLayout {
    padding-left: 10px;
    padding-right: 10px;
    spacing: 6px;
    cross-axis-alignment: center;

    Image {
      source: root.icon;
      width: 16px;
      height: 16px;
      colorize: Palette.foreground.with-alpha(0.72);
    }

    Text {
      text: root.label;
      color: Palette.foreground;
      font-size: 13px;
      font-weight: root.selected ? 600 : 400;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

component InstanceCard inherits Rectangle {
  in property <string> name;

  callback clicked();

  width: 240px;
  height: 88px;
  border-radius: 6px;
  background: touch.has-hover
    ? Palette.foreground.with-alpha(0.05)
    : Palette.background.with-alpha(0.5);
  border-width: 1px;
  border-color: Palette.foreground.with-alpha(0.08);

  HorizontalLayout {
    padding: 14px;
    spacing: 12px;
    cross-axis-alignment: center;

    Rectangle {
      width: 36px;
      height: 36px;
      border-radius: 6px;
      background: Palette.accent-background.with-alpha(0.14);

      Image {
        source: @image-url("../images/icons/instance.svg");
        width: 20px;
        height: 20px;
        colorize: Palette.foreground.with-alpha(0.72);
      }
    }

    VerticalLayout {
      horizontal-stretch: 1;
      alignment: center;
      spacing: 2px;

      Text {
        text: root.name;
        color: Palette.foreground;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
      }

      Text {
        text: "Minecraft 实例";
        color: Palette.foreground.with-alpha(0.55);
        font-size: 11px;
      }
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

// 原版版本筛选小胶囊
component FilterPill inherits Rectangle {
  in property <string> label;
  in property <bool> selected;

  callback clicked();

  height: 28px;
  min-width: 64px;
  horizontal-stretch: 0;
  border-radius: 6px;
  background: root.selected
    ? Palette.accent-background.with-alpha(0.16)
    : pill-touch.has-hover
      ? Palette.foreground.with-alpha(0.06)
      : transparent;

  HorizontalLayout {
    padding-left: 10px;
    padding-right: 10px;
    alignment: center;
    cross-axis-alignment: center;

    Text {
      text: root.label;
      color: root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.65);
      font-size: 12px;
      font-weight: root.selected ? 600 : 400;
      vertical-alignment: center;
    }
  }

  pill-touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

// 原版版本行
component VersionRow inherits Rectangle {
  in property <string> version-id;
  in property <string> kind-label;
  in property <string> release-date;
  in property <bool> installing;
  /// 全局是否有安装任务（用于禁用其它按钮）
  in property <bool> busy;

  callback install();

  height: 62px;
  background: transparent;

  // 注意：这个 TouchArea 必须声明在 card 之前，否则会盖住“安装”按钮。
  touch := TouchArea {
    mouse-cursor: pointer;
  }

  card := Rectangle {
    x: 0;
    y: 3px;
    width: 100%;
    height: 56px;
    border-radius: 6px;
    background: touch.has-hover
      ? Palette.foreground.with-alpha(0.10)
      : Palette.foreground.with-alpha(0.05);
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.12);

    HorizontalLayout {
      padding-left: 12px;
      padding-right: 8px;
      spacing: 10px;
      cross-axis-alignment: center;

      Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: Palette.accent-background.with-alpha(0.14);

        Image {
          source: @image-url("../images/icons/instance.svg");
          width: 18px;
          height: 18px;
          colorize: Palette.foreground.with-alpha(0.72);
        }
      }

      VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;

        Text {
          text: root.version-id;
          color: Palette.foreground;
          font-size: 13px;
          font-weight: 600;
          overflow: elide;
        }

        Text {
          text: root.release-date;
          color: Palette.foreground.with-alpha(0.5);
          font-size: 11px;
        }
      }

      // 类型徽章
      Rectangle {
        height: 20px;
        horizontal-stretch: 0;
        border-radius: 6px;
        background: #dbeafe;

        HorizontalLayout {
          padding-left: 6px;
          padding-right: 6px;
          alignment: center;
          cross-axis-alignment: center;

          Text {
            text: root.kind-label;
            color: #1e40af;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
          }
        }
      }

      Rectangle {
        height: 30px;
        min-width: 78px;
        horizontal-stretch: 0;
        border-radius: 6px;
        opacity: root.busy ? 0.4 : 1.0;
        border-width: 1px;
        border-color: Palette.accent-background.with-alpha(0.55);
        background: install-touch.has-hover && !root.busy
          ? Palette.accent-background.with-alpha(0.30)
          : Palette.accent-background.with-alpha(0.18);

        HorizontalLayout {
          padding-left: 12px;
          padding-right: 12px;
          alignment: center;
          cross-axis-alignment: center;

          Text {
            text: root.installing ? "安装中…" : "下载";
            color: Palette.accent-background;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
          }
        }

        install-touch := TouchArea {
          mouse-cursor: pointer;
          clicked => {
            if (!root.busy) {
              root.install();
            }
          }
        }
      }
    }
  }
}

// 向导顶部的返回按钮
component StepBackButton inherits Rectangle {
  callback clicked();

  width: 32px;
  height: 32px;
  border-radius: 6px;
  horizontal-stretch: 0;
  background: touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

  Text {
    text: "←";
    color: Palette.foreground.with-alpha(0.75);
    font-size: 18px;
    horizontal-alignment: center;
    vertical-alignment: center;
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

// 向导步骤标题
component WizardHeader inherits HorizontalLayout {
  in property <string> title;
  in property <string> subtitle;
  callback back();

  spacing: 10px;
  cross-axis-alignment: center;

  StepBackButton {
    clicked => {
      root.back();
    }
  }

  VerticalLayout {
    horizontal-stretch: 1;
    alignment: center;
    spacing: 2px;

    Text {
      text: root.title;
      color: Palette.foreground;
      font-size: 18px;
      font-weight: 600;
    }

    Text {
      text: root.subtitle;
      color: Palette.foreground.with-alpha(0.65);
      font-size: 13px;
      overflow: elide;
    }
  }
}

// 加载器选项
component LoaderCard inherits Rectangle {
  in property <string> title;
  in property <string> subtitle;
  in property <string> mark;

  callback clicked();

  height: 62px;
  border-radius: 6px;
  background: touch.has-hover
    ? Palette.foreground.with-alpha(0.08)
    : Palette.foreground.with-alpha(0.04);
  border-width: 1px;
  border-color: Palette.foreground.with-alpha(0.12);

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 12px;
    cross-axis-alignment: center;

    Rectangle {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: Palette.accent-background.with-alpha(0.16);

      Text {
        text: root.mark;
        color: Palette.accent-background;
        font-size: 15px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
      }
    }

    VerticalLayout {
      horizontal-stretch: 1;
      alignment: center;
      spacing: 2px;

      Text {
        text: root.title;
        color: Palette.foreground;
        font-size: 14px;
        font-weight: 600;
      }

      Text {
        text: root.subtitle;
        color: Palette.foreground.with-alpha(0.6);
        font-size: 12px;
        overflow: elide;
      }
    }

    Text {
      text: "→";
      color: Palette.foreground.with-alpha(0.45);
      font-size: 16px;
      vertical-alignment: center;
    }
  }

  touch := TouchArea {
    mouse-cursor: pointer;
    clicked => {
      root.clicked();
    }
  }
}

// 加载器版本行
component LoaderVersionRow inherits Rectangle {
  in property <string> version;
  in property <bool> stable;

  callback choose();

  height: 50px;
  background: touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

  HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 10px;
    cross-axis-alignment: center;

    Text {
      text: root.version;
      color: Palette.foreground;
      font-size: 14px;
      horizontal-stretch: 1;
      vertical-alignment: center;
      overflow: elide;
    }

    if root.stable : Rectangle {
      height: 20px;
      border-radius: 6px;
      background: #dbeafe;

      HorizontalLayout {
