  border-width: 1px;
  border-color: Palette.foreground.with-alpha(0.08);

  HorizontalLayout {
    padding: 14px;
    spacing: 12px;
    cross-axis-alignment: center;

    Rectangle {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      background: Palette.accent-background.with-alpha(0.14);

      Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: Palette.accent-background;
      }
    }

    VerticalLayout {
      alignment: center;
      spacing: 1px;

      Text {
        text: "\{root.count}";
